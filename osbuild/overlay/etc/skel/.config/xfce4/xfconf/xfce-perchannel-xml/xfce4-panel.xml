<?xml version="1.0" encoding="UTF-8"?>
<!-- tinywin panel: one bottom bar, Menu on the left, taskbar, tray, clock. -->
<channel name="xfce4-panel" version="1.0">
  <property name="configdir" type="string" value="/home/__USER__/.config/xfce4/panel"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="background-alpha" type="uint" value="92"/>
      <property name="background-style" type="uint" value="0"/>
      <property name="disable-struts" type="bool" value="false"/>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="mode" type="uint" value="0"/>
      <property name="position" type="string" value="p=8;x=0;y=0"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="40"/>
      <property name="size-adjust" type="bool" value="false"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/><value type="int" value="2"/>
        <value type="int" value="3"/><value type="int" value="4"/>
        <value type="int" value="5"/><value type="int" value="6"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="start-here"/>
      <property name="button-title" type="string" value="Menu"/>
      <property name="show-button-title" type="bool" value="true"/>
      <property name="show-button-icon" type="bool" value="false"/>
      <property name="launcher-show-name" type="bool" value="true"/>
      <property name="launcher-show-description" type="bool" value="true"/>
      <property name="view-mode" type="uint" value="0"/>
      <property name="menu-width" type="uint" value="480"/>
      <property name="menu-height" type="uint" value="560"/>
      <property name="menu-opacity" type="uint" value="96"/>
      <property name="category-icon-size" type="uint" value="1"/>
      <property name="show-command-actions" type="bool" value="true"/>
      <property name="favorites" type="array">
        <value type="string" value="thunar.desktop"/>
        <value type="string" value="tinywin-install.desktop"/>
        <value type="string" value="tinywin-update.desktop"/>
        <value type="string" value="tinywin-theme.desktop"/>
        <value type="string" value="tinywin-apps.desktop"/>
        <value type="string" value="xfce4-terminal.desktop"/>
        <value type="string" value="xfce4-settings-manager.desktop"/>
      </property>
    </property>
    <property name="plugin-2" type="string" value="tasklist">
      <property name="grouping" type="bool" value="true"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="show-labels" type="bool" value="true"/>
      <property name="show-handle" type="bool" value="false"/>
      <property name="middle-click" type="uint" value="2"/>
      <property name="sort-order" type="uint" value="2"/>
    </property>
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-4" type="string" value="systray">
      <property name="icon-size" type="uint" value="22"/>
      <property name="square-icons" type="bool" value="true"/>
      <property name="names-visible" type="array">
        <value type="string" value="nm-applet"/>
        <value type="string" value="xfce4-power-manager"/>
        <value type="string" value="clipman"/>
      </property>
    </property>
    <property name="plugin-5" type="string" value="pulseaudio">
      <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
      <property name="show-notifications" type="bool" value="false"/>
    </property>
    <property name="plugin-6" type="string" value="clock">
      <property name="digital-format" type="string" value="%a %d %b  %H:%M"/>
      <property name="mode" type="uint" value="2"/>
      <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
    </property>
  </property>
</channel>
